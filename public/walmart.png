<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400" width="100%" height="100%">
  <defs>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@700;800;900&amp;display=swap');
      .wm-bg { fill: #0071ce; }
      .wm-spark { fill: #ffc220; }
    </style>
  </defs>
  
  <!-- Blue Card Background matching uploaded walmart.png -->
  <rect width="800" height="400" rx="36" class="wm-bg" />

  <!-- Walmart Text & Spark Group Centered Perfectly in 800x400 -->
  <g transform="translate(-6, 0)">
    <!-- Custom Drawn Vector Walmart Typography for crisp accuracy -->
    <!-- W -->
    <path fill="#ffffff" d="M 60 148 L 78 248 L 96 248 L 115 178 L 134 248 L 152 248 L 170 148 L 148 148 L 137 218 L 121 155 L 109 155 L 93 218 L 82 148 Z"/>
    
    <!-- a -->
    <path fill="#ffffff" d="M 182 205 C 182 182 197 172 216 172 C 228 172 237 177 241 184 L 241 174 L 261 174 L 261 248 L 241 248 L 241 238 C 236 245 226 250 214 250 C 196 250 182 236 182 205 Z M 241 207 L 241 204 C 241 193 233 187 222 187 C 211 187 203 194 203 207 C 203 219 211 227 222 227 C 233 227 241 220 241 207 Z"/>
    
    <!-- l -->
    <path fill="#ffffff" d="M 276 135 L 297 135 L 297 248 L 276 248 Z"/>
    
    <!-- m -->
    <path fill="#ffffff" d="M 312 174 L 332 174 L 332 185 C 337 177 347 172 358 172 C 370 172 379 178 383 188 C 390 177 400 172 413 172 C 430 172 440 183 440 203 L 440 248 L 419 248 L 419 207 C 419 197 414 191 405 191 C 396 191 390 197 390 207 L 390 248 L 369 248 L 369 207 C 369 197 364 191 355 191 C 346 191 340 197 340 207 L 340 248 L 312 248 Z"/>
    
    <!-- a -->
    <path fill="#ffffff" d="M 454 205 C 454 182 469 172 488 172 C 500 172 509 177 513 184 L 513 174 L 533 174 L 533 248 L 513 248 L 513 238 C 508 245 498 250 486 250 C 468 250 454 236 454 205 Z M 513 207 L 513 204 C 513 193 505 187 494 187 C 483 187 475 194 475 207 C 475 219 483 227 494 227 C 505 227 513 220 513 207 Z"/>
    
    <!-- r -->
    <path fill="#ffffff" d="M 548 174 L 568 174 L 568 188 C 573 177 583 172 594 172 L 599 172 L 599 194 L 591 194 C 578 194 569 201 569 217 L 569 248 L 548 248 Z"/>
    
    <!-- t -->
    <path fill="#ffffff" d="M 618 153 L 618 174 L 638 174 L 638 191 L 618 191 L 618 230 C 618 236 621 238 627 238 C 631 238 635 237 638 236 L 638 250 C 633 252 626 253 620 253 C 606 253 598 244 598 229 L 598 191 L 587 191 L 587 174 L 598 174 L 598 153 Z"/>

    <!-- Six-ray Yellow Spark Icon -->
    <g transform="translate(685, 200)">
      <!-- Top (90 deg up) -->
      <path class="wm-spark" d="M -8.5 -32 C -8.5 -25 -5 -16 0 -16 C 5 -16 8.5 -25 8.5 -32 L 8.5 -64 C 8.5 -71 5 -78 0 -78 C -5 -78 -8.5 -71 -8.5 -64 Z"/>
      <!-- Top Right (30 deg) -->
      <g transform="rotate(60)">
        <path class="wm-spark" d="M -8.5 -32 C -8.5 -25 -5 -16 0 -16 C 5 -16 8.5 -25 8.5 -32 L 8.5 -64 C 8.5 -71 5 -78 0 -78 C -5 -78 -8.5 -71 -8.5 -64 Z"/>
      </g>
      <!-- Bottom Right (330 deg) -->
      <g transform="rotate(120)">
        <path class="wm-spark" d="M -8.5 -32 C -8.5 -25 -5 -16 0 -16 C 5 -16 8.5 -25 8.5 -32 L 8.5 -64 C 8.5 -71 5 -78 0 -78 C -5 -78 -8.5 -71 -8.5 -64 Z"/>
      </g>
      <!-- Bottom (270 deg) -->
      <g transform="rotate(180)">
        <path class="wm-spark" d="M -8.5 -32 C -8.5 -25 -5 -16 0 -16 C 5 -16 8.5 -25 8.5 -32 L 8.5 -64 C 8.5 -71 5 -78 0 -78 C -5 -78 -8.5 -71 -8.5 -64 Z"/>
      </g>
      <!-- Bottom Left (210 deg) -->
      <g transform="rotate(240)">
        <path class="wm-spark" d="M -8.5 -32 C -8.5 -25 -5 -16 0 -16 C 5 -16 8.5 -25 8.5 -32 L 8.5 -64 C 8.5 -71 5 -78 0 -78 C -5 -78 -8.5 -71 -8.5 -64 Z"/>
      </g>
      <!-- Top Left (150 deg) -->
      <g transform="rotate(300)">
        <path class="wm-spark" d="M -8.5 -32 C -8.5 -25 -5 -16 0 -16 C 5 -16 8.5 -25 8.5 -32 L 8.5 -64 C 8.5 -71 5 -78 0 -78 C -5 -78 -8.5 -71 -8.5 -64 Z"/>
      </g>
    </g>
  </g>
</svg>
